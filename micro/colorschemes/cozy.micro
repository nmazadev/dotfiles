# cozy: uses only the terminal's 16 ANSI colors, so micro follows the desktop theme
# (cocoa, nord, ...) like vim's cozy colorscheme does.
# 1 red/accent, 2 green, 3 yellow/amber, 4 blue, 5 magenta, 6 cyan, 7 text, 8 muted

color-link default "default,default"
color-link comment "italic 8"
color-link constant "3"
color-link constant.string "2"
color-link constant.number "3"
color-link identifier "6"
color-link statement "5"
color-link symbol "7"
color-link preproc "1"
color-link type "3"
color-link special "6"
color-link underlined "underline 4"
color-link error "0,1"
color-link todo "bold 0,3"
color-link hlsearch "0,3"
color-link selection "0,3"
color-link line-number "8"
color-link current-line-number "bold 1"
color-link statusline "7,8"
color-link tabbar "7,8"
color-link message "7"
color-link error-message "bold 1"
color-link indent-char "8"
color-link scrollbar "8"
color-link divider "8"
color-link gutter-error "1"
color-link gutter-warning "3"
color-link diff-added "2"
color-link diff-modified "3"
color-link diff-deleted "1"
color-link match-brace "bold underline 1"
