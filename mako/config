# mako notification daemon. Colors come from pywal (see wal/templates/colors-mako),
# regenerated on every wallpaper change by hypr/scripts/wallpaper.sh.

font=JetBrains Mono 10
width=300
height=100
margin=8
padding=10
border-size=2
border-radius=12
icons=1
max-icon-size=48
default-timeout=6000
anchor=top-right
layer=overlay

# Fallback colors, overridden by the pywal include below
background-color=#1c1412E6
text-color=#f0e4d2
border-color=#c4785a
progress-color=over #f0aa6e

# Pywal colors, override the fallbacks above
include=~/.cache/wal/colors-mako

# "now playing" (shown on each new song by media-cover.sh): a bigger cover
[app-name=now-playing]
max-icon-size=96
width=360

[urgency=high]
border-color=#e66e6e
default-timeout=0

# Do not disturb (waybar bell / SUPER+N): hide everything, still kept in history
[mode=do-not-disturb]
invisible=1
