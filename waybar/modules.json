//   _ _ _ _____ __ __ _____ _____ _____
//  | | | |  _  |  |  | __  |  _  | __  |
//  | | | |     |_   _| __ -|     |    -|
//  |_____|__|__| |_| |_____|__|__|__|__|  MODULES
//
//  by Bina


{
	// workspaces
	// Workspaces through the ext-workspace protocol: clicking a number switches to it.
	// (hyprland/workspaces sends the old "dispatch workspace N" IPC command on click,
	// which the Lua config rejects, so clicks did nothing.)
	"ext/workspaces": {
		"format": "{name}",
		"on-click": "activate",
		"sort-by-id": true,
		"ignore-hidden": true
	},
   	
	// clock
	"clock": {  
		"interval": 60,
		"format": "󰥔  {:%A, %B %d - %H:%M}",
		"format-alt": "󰥔  {:%H:%M}", // click to toggle the short version
		"tooltip-format": "<big>{calendar}</big>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#ffffff'><b>{}</b></span>",
				"days": "<span color='#ffffff'><b>{}</b></span>",
				"weeks": "<span color='#ffffff'><b>W{}</b></span>",
				"weekdays": "<span color='#ffffff'><b>{}</b></span>",
				"today": "<span color='#ffffff'><b><u>{}</u></b></span>"
			}
		}
	},
	
	// hardware
	"group/hardware": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 300,
			"children-class": "not-memory",
			"transition-left-to-right": false
		},        
		"modules": [
			"custom/system",
			"cpu",
			"temperature",
			"disk",
			"memory"
		]
	},
	
	// system
	"custom/system": {
		"format": "<span size='small'> 󰄨 </span>",
		"tooltip": false
	},
	
	// CPU
	"cpu": {
		"format": " 󰍛 {usage}% ",
		"on-click": "kitty btop"
	},
	
	// temperature
	"temperature": {
		"format": " 󰈸 {temperatureC}°C ",
		"on-click": "kitty btop"
	},
	
	// harddisc space
	"disk": {
		"interval": 30,
		"format": " 󰋊 {percentage_used}% ",
		"path": "/",
		"on-click": "kitty btop"
	}, 
	
	// memory
	"memory": {
		"format": "  {}% ",
		"on-click": "kitty btop"
	},
	
	// now playing: track title, then previous / play-pause / next.
	// The buttons follow playerctl events (no polling) and print nothing while
	// Spotify is not running, which hides them.
	"group/media": {
		"orientation": "inherit",
		"modules": [
			"mpris",
			"custom/media-prev",
			"custom/media-toggle",
			"custom/media-next"
		]
	},

	"custom/media-prev": {
		"exec": "playerctl -p spotify --follow status 2>/dev/null | while read -r s; do case $s in Playing|Paused|Stopped) echo 󰒮;; *) echo;; esac; done",
		"on-click": "playerctl -p spotify previous",
		"tooltip": false
	},

	"custom/media-toggle": {
		"exec": "playerctl -p spotify --follow status 2>/dev/null | while read -r s; do case $s in Playing) echo 󰏤;; Paused|Stopped) echo 󰐊;; *) echo;; esac; done",
		"on-click": "playerctl -p spotify play-pause",
		"tooltip": false
	},

	"custom/media-next": {
		"exec": "playerctl -p spotify --follow status 2>/dev/null | while read -r s; do case $s in Playing|Paused|Stopped) echo 󰒭;; *) echo;; esac; done",
		"on-click": "playerctl -p spotify next",
		"tooltip": false
	},

	// current track (Spotify only); click to play/pause
	"mpris": {
		"player": "spotify",
		"format": "{player_icon} {artist} - {title}",
		"format-paused": "{player_icon} {artist} - {title}",
		"player-icons": {
			"default": "󰎆"
		},
		"max-length": 40,
		"title-len": 25,
		"artist-len": 15,
		"tooltip-format": "{player}: {album}\n{artist} - {title}",
		"on-click": "playerctl -p spotify play-pause"
	},

	// keyboard layout (switch with ALT+SHIFT, or click)
	"hyprland/language": {
		"format": "󰌌 {short}",
		"on-click": "hyprctl switchxkblayout all next",
		"tooltip-format": "{long}"
	},

	// audio
	"pulseaudio": {
		"scroll-step": 1,
		"format": "{icon}  {volume}%",
		"format-bluetooth": "{volume}% {icon} {format_source}",
		"format-bluetooth-muted": "󰖁 {icon} {format_source}",
		"format-muted": "󰖁 {format_source}",
		"format-source": "{volume}% ",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"phone": "",
			"car": "",
			"default": ["", "", ""]
		},
		"on-click": "kitty wiremix"
	},
	
	// bluetooth
	"bluetooth": {
		"format": " {status}",
		"format-disabled": " {status}",
		"format-off": " {status}",
		"interval": 30,
		"on-click": "kitty sh -c 'bluetui'",
		"format-no-controller": ""
	},
	
	// network
	"network": {
		"format": "{ifname}",
		"format-wifi": "  {signalStrength}%",
		"format-ethernet": "󰌘 {ifname}",
		"format-disconnected": "disconnected",
		"tooltip-format": "󰌘 {ifname} via {gwaddri}",
		"tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\n {bandwidthUpBits}  {bandwidthDownBits}",
		"tooltip-format-ethernet": "󰌘 {ifname}\nIP: {ipaddr}\n  {bandwidthUpBits}  {bandwidthDownBits}",
		"tooltip-format-disconnected": "disconnected",
		"max-length": 50,
		"on-click": "kitty nmtui"
		//"on-click": "~/dotfiles/.settings/networkmanager.sh"
	},
	
	// battery
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 10
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-icons": ["", "", "", "", ""],
		// power profiles: click for the picker, right-click to cycle
		"tooltip-format": "{timeTo}\nClick: power profile · right-click: next",
		"on-click": "~/.config/hypr/scripts/power-profile.sh",
		"on-click-right": "~/.config/hypr/scripts/power-profile.sh next"
	},
	
	// do not disturb: click to silence notifications (mako mode), icon shows the state
	"custom/notifications": {
		"exec": "makoctl mode | grep -qx do-not-disturb && echo 󰂛 || echo 󰂚",
		"interval": "once",
		"signal": 8,
		"on-click": "makoctl mode -t do-not-disturb >/dev/null; pkill -RTMIN+8 waybar",
		"tooltip-format": "Notifications: click to toggle do not disturb"
	},

	// system tray, collapsed behind one button: click it to show the icons.
	// Left-click an icon opens the app, right-click shows its menu (Quit, ...).
	// named systray so its CSS id (#systray) does not clash with the tray module (#tray)
	"group/systray": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 300,
			"click-to-reveal": true,
			"children-class": "tray-child",
			"transition-left-to-right": true
		},
		"modules": [
			"custom/tray-toggle",
			"tray"
		]
	},

	"custom/tray-toggle": {
		"format": "󰅂",
		"tooltip-format": "Tray: click to show"
	},

	"tray": {
		"icon-size": 15,
		"spacing": 8,
		"show-passive-items": true
	},

	// power menu
	"custom/exit": {
		"format": "",
		"on-click": "wlogout -b 2",
		"tooltip": false		
	},
}


