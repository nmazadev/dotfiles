# btop theme from the current desktop theme (see hypr/scripts/theme.sh).
# Background is left empty so btop uses the terminal's (themed, translucent) one.
# cursor is the theme's accent; color1..6 are its palette.

theme[main_bg]=""
theme[main_fg]="{foreground}"
theme[title]="{foreground}"
theme[hi_fg]="{cursor}"
theme[selected_bg]="{cursor}"
theme[selected_fg]="{background}"
theme[inactive_fg]="{color8}"
theme[graph_text]="{color8}"
theme[meter_bg]="{color8}"
theme[proc_misc]="{color2}"

# box outlines: muted, the accent is kept for what matters
theme[cpu_box]="{color8}"
theme[mem_box]="{color8}"
theme[net_box]="{color8}"
theme[proc_box]="{color8}"
theme[div_line]="{color8}"

# gradients go calm -> warm -> accent as load rises
theme[temp_start]="{color4}"
theme[temp_mid]="{color3}"
theme[temp_end]="{color1}"
theme[cpu_start]="{color2}"
theme[cpu_mid]="{color3}"
theme[cpu_end]="{color1}"
theme[free_start]="{color2}"
theme[free_mid]="{color2}"
theme[free_end]="{color2}"
theme[cached_start]="{color4}"
theme[cached_mid]="{color4}"
theme[cached_end]="{color4}"
theme[available_start]="{color6}"
theme[available_mid]="{color6}"
theme[available_end]="{color6}"
theme[used_start]="{color3}"
theme[used_mid]="{color3}"
theme[used_end]="{color1}"
theme[download_start]="{color4}"
theme[download_mid]="{color6}"
theme[download_end]="{color2}"
theme[upload_start]="{color5}"
theme[upload_mid]="{color3}"
theme[upload_end]="{color1}"
theme[process_start]="{color2}"
theme[process_mid]="{color3}"
theme[process_end]="{color1}"
